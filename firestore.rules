rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == 'qOMuMaSt56VLYARCvYccyxJu8rG2';
    }

    function validPerson(d) {
      return d.keys().hasOnly(['name', 'birthDate', 'deathDate', 'photoUrl', 'type', 'refId'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.birthDate is string && d.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.deathDate is string && (d.deathDate == '' || d.deathDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && d.photoUrl is string
        && (d.photoUrl == '' || d.photoUrl.matches('^data:image/.*') || d.photoUrl.matches('^https?://.*'))
        && d.type in ['root', 'child', 'spouse']
        && d.refId is string;
    }

    match /people/{personId} {
      allow read: if true;
      allow create, update: if isAdmin() && validPerson(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}