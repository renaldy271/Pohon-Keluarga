rules_version = '2';

// Semua orang boleh MEMBACA pohon keluarga.
// Hanya satu akun admin (dikenali lewat UID) yang boleh menambah, mengubah, dan menghapus.
// Ganti GANTI_DENGAN_UID_ADMIN dengan User UID dari Firebase Console > Authentication > Users.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == 'GANTI_DENGAN_UID_ADMIN';
    }

    function validPerson(d) {
      return d.keys().hasOnly(['name', 'birthDate', 'deathDate', 'type', 'refId'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.birthDate is string && d.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.deathDate is string && (d.deathDate == '' || d.deathDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && d.type in ['root', 'child', 'spouse']
        && d.refId is string;
    }

    match /people/{personId} {
      allow read: if true;
      allow create, update: if isAdmin() && validPerson(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
